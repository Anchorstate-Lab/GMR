from typing import Any, Optional

CONTRACT: str

class Fault(ValueError):
    """Every refusal and failure, spoken as `<kind>: <message>`.

    kind is a stable snake_case token -- `refused` (the console would not
    parse the ask), `assembly` (the runtime could not be put together),
    `internal`, or a runtime code such as `not_bound`, `no_such_anchor`,
    `no_provider`, `condensed_into_nothing`. Match the token, not the prose.
    """

def open(options: dict[str, Any]) -> Gmr: ...

class Gmr:
    def sample(self, anchor: str, how: Optional[dict[str, Any]] = None) -> dict[str, Any]: ...
    def read(self, anchor: str, how: Optional[dict[str, Any]] = None) -> dict[str, Any]: ...
    def ground(self, claims: list[str | dict[str, Any]], how: Optional[dict[str, Any]] = None) -> list[dict[str, Any]]: ...
    def since(self, cursor: int, status: Optional[str] = None) -> dict[str, Any]: ...
    def bind(self, claim: str, anchors: list[str], source: str, how: Optional[dict[str, Any]] = None) -> dict[str, Any]: ...
    def revoke(self, claim: str, source: str) -> dict[str, Any]: ...
    def link(self, from_: str, to: str, kind: str, source: str) -> None: ...
